<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        ============================================================
        LOSTLINK-SERVICE — Core Business Service
        ============================================================
        This is the main microservice that contains all business logic:
        - User management (registration, authentication)
        - Lost/Found item CRUD
        - Claim processing workflow
        - Dashboard statistics

        It registers with Eureka and is accessed through the API Gateway.
        ============================================================
    -->
    <parent>
        <groupId>com.example</groupId>
        <artifactId>lostlink</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lostlink-service</artifactId>
    <name>LostLink Service</name>
    <description>Core business service for LostLink</description>

    <dependencies>
        <!-- ============================================================
             SPRING BOOT STARTERS
             Each "starter" is a curated set of auto-configuration classes
             and dependencies for a specific concern.
             ============================================================ -->

        <!-- Spring Web MVC — provides REST controller, @RestController,
             DispatcherServlet, and embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA — provides Repository abstraction,
             Hibernate ORM, and automatic CRUD operations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security — provides authentication & authorization,
             filter chains, and method-level security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta) — provides @NotNull, @Size,
             @Email, @Pattern etc. for request validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             SPRING CLOUD — Service Discovery & Configuration
             ============================================================ -->

        <!-- Eureka Client — registers this service with Eureka Server
             so the Gateway and other services can discover it -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- OpenFeign — declarative REST client for calling other
             microservices without writing boilerplate HTTP code -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Config Client — fetches configuration from Config Server
             at startup (application.yml, DB credentials, etc.) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- Bootstrap — required for reading bootstrap.yml before
             application.yml when using Config Server -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!-- ============================================================
             RESILIENCE
             ============================================================ -->

        <!-- Resilience4j — Circuit Breaker, Retry, Rate Limiter
             Prevents cascading failures in microservice calls -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>

        <!-- ============================================================
             DATABASE
             ============================================================ -->

        <!-- MySQL Connector/J — JDBC driver for MySQL database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 Database — in-memory DB for testing without MySQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- ============================================================
             JWT (JSON Web Token)
             ============================================================ -->

        <!-- JJWT API — interfaces for creating/parsing JWTs -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <!-- JJWT Implementation — actual HMAC/RSA algorithms -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JJWT Jackson — JSON serialization for JWT claims -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             DOCUMENTATION
             ============================================================ -->

        <!-- SpringDoc OpenAPI — auto-generates Swagger UI and
             OpenAPI 3.0 spec from your controllers -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- ============================================================
             UTILITIES
             ============================================================ -->

        <!-- Lombok — generates getters, setters, constructors,
             builders, and logging at compile time.
             Reduces boilerplate code significantly. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             DEVELOPMENT TOOLS
             ============================================================ -->

        <!-- DevTools — provides hot reload (auto-restart on code change)
             and live configuration refresh during development -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             TESTING
             ============================================================ -->

        <!-- Spring Boot Test — includes JUnit 5, Mockito, AssertJ,
             Spring Test context, and TestRestTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test — provides @WithMockUser and
             security-related test utilities -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin — packages the app as an
                 executable JAR / WAR and supports `spring-boot:run` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok should not be included in the
                             final JAR since it only works at
                             compile time -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>